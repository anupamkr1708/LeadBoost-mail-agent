# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------
# Local dev default. On Render, this is provided automatically by the
# managed Postgres instance (see render.yaml) -- don't set it manually there.
DATABASE_URL=sqlite:///./mailer_agent.db

# --- LLM (Groq) ---------------------------------------------------------
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=500

# --- Outbound mail (SMTP) ------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Inbound mail (IMAP, same mailbox as SMTP_USERNAME in most setups) ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=120

# --- Follow-up scheduler --------------------------------------------------
FOLLOWUP_POLL_SECONDS=300
# Set to false when running the API and the scheduler as two separate
# processes/services (e.g. Render Web Service + Background Worker via
# render.yaml) -- true is correct for local dev (`python run.py` alone).
RUN_SCHEDULER_IN_PROCESS=true

# --- Safety toggles --------------------------------------------------------
# Keep both false while testing. Flip LIVE_SENDING_ENABLED once you've
# reviewed draft output in the DB and are ready for real sends.
LIVE_SENDING_ENABLED=false
AUTO_REPLY_ENABLED=false
MAX_SENDS_PER_CYCLE=20

# --- API ---------------------------------------------------------------
# If set, every request must include header: X-API-Key: <this value>
API_KEY=
